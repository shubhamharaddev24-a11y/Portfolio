# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# The recipient email where you want to receive portfolio messages
TO_EMAIL=shubhamharad25@gmail.com

# Sender email:
# During free development, Resend allows 'onboarding@resend.dev' to deliver to your registered email.
# Once you verify your custom domain on Resend, you can change this to e.g. 'contact@yourdomain.com'.
FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Server Port
PORT=5050
